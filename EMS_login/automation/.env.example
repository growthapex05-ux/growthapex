# WhatsApp Report Automation Settings

# PROVIDER options: "whatsapp-web-js" (free, local scan) or "green-api" (cloud instance)
PROVIDER=whatsapp-web-js

# Target WhatsApp Group Invite link or JID
WA_INVITE_LINK=https://chat.whatsapp.com/CUHTYqpNen9HMYUZREoxCb
WA_GROUP_JID=

# (Only if PROVIDER=green-api) Green API instance details
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
# API host shown in the Green-API console (apiUrl)
GREEN_API_URL=https://api.green-api.com

# Path to the Firebase Service Account JSON key (defaults to local file)
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# Schedule times, 24h HH:MM (re-run setup-tasks.ps1 after changing)
DAILY_REPORT_TIME=19:00
MORNING_REPORT_TIME=11:00
WEEKLY_REPORT_TIME=10:00
MONTHLY_REPORT_TIME=10:00
FLUSH_INTERVAL_MINUTES=15

# Offline handling: how long to wait for internet before queueing, and how long queued messages are kept
NETWORK_WAIT_MINUTES=10
MAX_QUEUE_AGE_HOURS=72

# Personal WhatsApp reminders to employees (HH:MM, IST)
REMIND_CHECKIN_TIME=10:15
REMIND_CHECKOUT_TIME=22:00

# Missed-report catch-up: how many past days to check, and never before this date
CATCH_UP_DAYS=3
CATCH_UP_START_DATE=2026-10-27


# Email copy of check-in alerts + daily / weekly / monthly reports (Hostinger mailbox of growthapex.in)
# EMAIL_APP_PASSWORD = the password of the support@growthapex.in mailbox (Hostinger -> Emails)
# Leave it empty to turn email off.
EMAIL_USER=support@growthapex.in
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
EMAIL_APP_PASSWORD=
EMAIL_TO=growthapex05@gmail.com

# Personal WhatsApp when a checked-in employee goes offline / is auto-checked-out in office hours
OFFLINE_ALERT_MINUTES=10
OFFLINE_ALERT_MOBILE_MINUTES=60
AUTO_CHECKOUT_ALERT_MINUTES=5
MAX_OFFLINE_ALERTS=3
WORK_START_TIME=10:00
WORK_END_TIME=19:00
# Personal + group WhatsApp when ActivityWatch sees no mouse/keyboard on the laptop for this long
INACTIVE_ALERT_MINUTES=30
