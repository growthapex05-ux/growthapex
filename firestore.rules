rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isAdmin() {
      return signedIn() && myEmail() == 'growthapex05@gmail.com';
    }
    // Staff = an email registered by the admin in staffEmails/{email}
    function isStaff() {
      return signedIn() && exists(/databases/$(database)/documents/staffEmails/$(myEmail()));
    }

    // Login page: Employee ID -> email lookup (single get only, no listing)
    match /empLogin/{empId} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    // Registered staff emails (managed by admin only)
    match /staffEmails/{email} {
      allow read: if isAdmin() || (signedIn() && myEmail() == email);
      allow write: if isAdmin();
    }

    // Everything else: admin + registered staff only.
    // Random accounts created with the public API key get nothing.
    match /{coll}/{rest=**} {
      allow read, write: if isAdmin()
        || (isStaff() && !(coll in ['empLogin', 'staffEmails', 'automation_sent']));
    }
  }
}
